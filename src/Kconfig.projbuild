# O pinout completo da placa MKS DUAL FOC V3.2 (todos os GPIOs, headers e
# restrições elétricas) vive no componente components/mks_dual_foc_v32.
#
# Aqui só a ligação do projeto: LED de status e as saídas analógicas dos dois
# AS5600.

menu "Configuração do Controlador por Volante de Inércia"

    menu "Sistema"

        config BLINK_GPIO
            int "GPIO do LED de status"
            range 0 39
            default 2
            help
                GPIO do LED externo. IO2 é um dos GPIOs livres da placa; a
                placa base não tem LED acionável por GPIO.
    endmenu

    # Modo analógico do AS5600: a saída OUT (0-3.3 V) vai para um GPIO com ADC.
    menu "Encoders magnéticos AS5600 (analógico)"

        config ENCODER1_ADC_GPIO
            int "GPIO analógico do encoder 1 (motor)"
            range 0 39
            default 13
            help
                Net I_1 (ADC2_CH4), pino 12 do header H1. Ligue o OUT do
                AS5600 do motor aqui, junto a GND e 3V3.

        config ENCODER2_ADC_GPIO
            int "GPIO analógico do encoder 2 (volante)"
            range 0 39
            default 15
            help
                Net I_0 (ADC2_CH3), pino 11 do header H1. Ligue o OUT do
                AS5600 do volante aqui.

                IO15 é strapping (MTDO): a placa já tem pull-up de 4.7 kOhm
                na net (RN2).
    endmenu

endmenu
